---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { sanityClient } from "~/lib/sanity";
import { sponsorsForPathsQuery } from "~/lib/queries";
import type { SponsorsForPathsQueryResult } from "~/lib/sanity.types";
import SingleSponsorPage from "~/page-content/single-sponsor-page";

type SponsorDoc = SponsorsForPathsQueryResult[number];

export async function getStaticPaths() {
    const sponsors = await sanityClient.fetch<SponsorsForPathsQueryResult>(sponsorsForPathsQuery);

    return sponsors.map((sponsor) => ({
        params: { slug: sponsor.slug },
        props: { sponsor },
    }));
}

const { sponsor } = Astro.props as { sponsor: SponsorDoc };
const title = `${sponsor.name ?? "Sponsor"} - Matlock Raft Event`;

const truncate = (text: string, max = 155): string =>
    text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text;

const rawDescription = sponsor.description?.replace(/\s+/g, " ").trim();
const description = rawDescription
    ? truncate(rawDescription)
    : `${sponsor.name ?? "A local business"} is a proud sponsor of The Matlock Raft Event, the Boxing Day charity raft race raising money for the RNLI.`;
---
<BaseLayout description={description} title={title}>
    <SingleSponsorPage client:load sponsor={sponsor} />
</BaseLayout>
