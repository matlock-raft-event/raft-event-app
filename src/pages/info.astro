---
import BaseLayout from "~/layouts/BaseLayout.astro";
import InfoPage from "~/page-content/info-page";
import { sanityClient, urlFor } from "~/lib/sanity";

const galleryImgs = await sanityClient.fetch<Array<{ img: unknown }>>(
    `*[_type == "galleryImage" && defined(img)][0...5]{ img }`
);
const cardImages = galleryImgs.map((g) =>
    urlFor(g.img).width(900).height(700).fit("crop").auto("format").url()
);
---
<BaseLayout
    description="Everything you need to know about The Matlock Raft Event — the race route and timings, getting here, where to watch, and FAQs."
    title="Event Information - Matlock Raft Event"
>
    <InfoPage client:load cardImages={cardImages} />
</BaseLayout>
