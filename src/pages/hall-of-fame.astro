---
import BaseLayout from "~/layouts/BaseLayout.astro";
import HallOfFamePage from "~/page-content/hall-of-fame-page";
import { sanityClient } from "~/lib/sanity";
import { winnersQuery } from "~/lib/queries";
import type { WinnersQueryResult } from "~/lib/sanity.types";

const winners = await sanityClient.fetch<WinnersQueryResult>(winnersQuery);
---
<BaseLayout
    description="The Matlock Raft Event hall of fame — the winning rafts from every year of our Boxing Day charity raft race on the River Derwent."
    title="Hall of Fame - Matlock Raft Event"
>
    <HallOfFamePage client:load winners={winners} />
</BaseLayout>
